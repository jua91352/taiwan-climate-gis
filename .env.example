CWA_API_KEY=your_cwa_api_key_here

# Optional. Set on Vercel as project environment variables (Vercel does not read .env):
#   CWA_API_KEY      the key above
#   RADAR_COLLECTOR  0 disables the background radar collector thread (needed on Vercel)
#   WEATHER_DB_PATH  SQLite file location; defaults to data/weather.db locally and to
#                    the temp directory (/tmp/weather.db) when running on Vercel
